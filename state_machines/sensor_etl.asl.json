{
  "Comment": "PulseGrid combined orchestration -- glue/sensor_etl and redshift_refresh sections, both apply lock-only-when-work-exists ordering from the start.",
  "StartAt": "ModeCheck1",
  "States": {
    "ModeCheck1": {
      "Type": "Choice",
      "Choices": [
        {
          "And": [
            { "Variable": "$.mode", "IsPresent": true },
            { "Variable": "$.mode", "StringEquals": "redshift_only" }
          ],
          "Next": "GetMissingDates"
        }
      ],
      "Default": "GetMissingHours"
    },
    "ClaimLock": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "pulsegrid-dev-watermarks",
        "Key": { "pipeline_id": { "S": "sensor_etl" } },
        "UpdateExpression": "SET #s = :running",
        "ConditionExpression": "attribute_not_exists(#s) OR #s <> :running",
        "ExpressionAttributeNames": { "#s": "status" },
        "ExpressionAttributeValues": { ":running": { "S": "RUNNING" } }
      },
      "ResultPath": null,
      "Catch": [
        { "ErrorEquals": ["DynamoDB.ConditionalCheckFailedException"], "Next": "AlreadyRunning" }
      ],
      "Next": "StartRawCrawler"
    },
    "AlreadyRunning": { "Type": "Succeed" },
    "StartRawCrawler": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:glue:startCrawler",
      "Parameters": { "Name": "pulsegrid-dev-raw-crawler" },
      "ResultPath": null,
      "Catch": [
        { "ErrorEquals": ["States.ALL"], "Next": "ReleaseLockOnFailure", "ResultPath": "$.error" }
      ],
      "Next": "WaitForCrawler"
    },
    "WaitForCrawler": { "Type": "Wait", "Seconds": 20, "Next": "GetCrawlerStatus" },
    "GetCrawlerStatus": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:glue:getCrawler",
      "Parameters": { "Name": "pulsegrid-dev-raw-crawler" },
      "ResultPath": "$.crawlerStatus",
      "Catch": [
        { "ErrorEquals": ["States.ALL"], "Next": "ReleaseLockOnFailure", "ResultPath": "$.error" }
      ],
      "Next": "CheckCrawlerStatus"
    },
    "CheckCrawlerStatus": {
      "Type": "Choice",
      "Choices": [
        { "Variable": "$.crawlerStatus.Crawler.State", "StringEquals": "READY", "Next": "RunGlueJob" }
      ],
      "Default": "WaitForCrawler"
    },
    "GetMissingHours": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "pulsegrid-dev-missing-hours",
        "Payload.$": "$"
      },
      "ResultSelector": { "missing_groups.$": "$.Payload.missing_groups" },
      "ResultPath": "$.lambdaResult",
      "Catch": [
        { "ErrorEquals": ["States.ALL"], "Next": "Fail", "ResultPath": "$.error" }
      ],
      "Next": "CheckIfAnyMissing"
    },
    "CheckIfAnyMissing": {
      "Type": "Choice",
      "Choices": [
        { "Variable": "$.lambdaResult.missing_groups[0]", "IsPresent": true, "Next": "ClaimLock" }
      ],
      "Default": "AllCaughtUp"
    },
    "RunGlueJob": {
      "Type": "Task",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Parameters": {
        "JobName": "pulsegrid-dev-sensor-etl",
        "Arguments": { "--date_groups.$": "States.JsonToString($.lambdaResult.missing_groups)" }
      },
      "Retry": [
        { "ErrorEquals": ["Glue.ConcurrentRunsExceededException"], "IntervalSeconds": 60, "MaxAttempts": 3, "BackoffRate": 2.0 }
      ],
      "Catch": [
        { "ErrorEquals": ["States.ALL"], "Next": "ReleaseLockOnFailure", "ResultPath": "$.error" }
      ],
      "ResultPath": "$.glueResult",
      "Next": "ReleaseLockOnSuccess"
    },
    "ReleaseLockOnSuccess": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "pulsegrid-dev-watermarks",
        "Key": { "pipeline_id": { "S": "sensor_etl" } },
        "UpdateExpression": "SET #s = :idle",
        "ExpressionAttributeNames": { "#s": "status" },
        "ExpressionAttributeValues": { ":idle": { "S": "IDLE" } }
      },
      "ResultPath": null,
      "Next": "ModeCheck2",
      "Retry": [
        { "ErrorEquals": ["States.ALL"], "IntervalSeconds": 5, "MaxAttempts": 3, "BackoffRate": 2.0 }
      ]
    },
    "ModeCheck2": {
      "Type": "Choice",
      "Choices": [
        {
          "And": [
            { "Variable": "$.mode", "IsPresent": true },
            { "Variable": "$.mode", "StringEquals": "glue_only" }
          ],
          "Next": "ExecutionComplete"
        }
      ],
      "Default": "GetMissingDates"
    },
    "ExecutionComplete": { "Type": "Succeed" },
    "ReleaseLockOnFailure": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "pulsegrid-dev-watermarks",
        "Key": { "pipeline_id": { "S": "sensor_etl" } },
        "UpdateExpression": "SET #s = :idle",
        "ExpressionAttributeNames": { "#s": "status" },
        "ExpressionAttributeValues": { ":idle": { "S": "IDLE" } }
      },
      "ResultPath": null,
      "Next": "Fail",
      "Retry": [
        { "ErrorEquals": ["States.ALL"], "IntervalSeconds": 5, "MaxAttempts": 3, "BackoffRate": 2.0 }
      ]
    },
    "Fail": { "Type": "Fail" },
    "AllCaughtUp": { "Type": "Succeed" },
    "GetMissingDates": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "pulsegrid-dev-missing-dates",
        "Payload.$": "$"
      },
      "ResultSelector": {
        "start_date.$": "$.Payload.start_date",
        "end_date.$": "$.Payload.end_date"
      },
      "ResultPath": "$.redshiftResult",
      "Catch": [
        { "ErrorEquals": ["States.ALL"], "Next": "Fail", "ResultPath": "$.error" }
      ],
      "Next": "CheckIfAnyDatesMissing"
    },
    "CheckIfAnyDatesMissing": {
      "Type": "Choice",
      "Choices": [
        { "Variable": "$.redshiftResult.start_date", "IsPresent": true, "Next": "ClaimRedshiftLock" }
      ],
      "Default": "RedshiftAllCaughtUp"
    },
    "RedshiftAllCaughtUp": { "Type": "Succeed" },
    "ClaimRedshiftLock": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "pulsegrid-dev-watermarks",
        "Key": { "pipeline_id": { "S": "redshift_refresh" } },
        "UpdateExpression": "SET #s = :running",
        "ConditionExpression": "attribute_not_exists(#s) OR #s <> :running",
        "ExpressionAttributeNames": { "#s": "status" },
        "ExpressionAttributeValues": { ":running": { "S": "RUNNING" } }
      },
      "ResultPath": null,
      "Catch": [
        { "ErrorEquals": ["DynamoDB.ConditionalCheckFailedException"], "Next": "RedshiftAlreadyRunning" }
      ],
      "Next": "CrawlCuratedSchemas"
    },
    "RedshiftAlreadyRunning": { "Type": "Succeed" },
    "CrawlCuratedSchemas": {
      "Type": "Parallel",
      "Branches": [
        {
          "StartAt": "StartCuratedCrawler",
          "States": {
            "StartCuratedCrawler": {
              "Type": "Task",
              "Resource": "arn:aws:states:::aws-sdk:glue:startCrawler",
              "Parameters": { "Name": "pulsegrid-dev-curated-crawler" },
              "ResultPath": null,
              "Next": "WaitForCuratedCrawler"
            },
            "WaitForCuratedCrawler": { "Type": "Wait", "Seconds": 20, "Next": "GetCuratedCrawlerStatus" },
            "GetCuratedCrawlerStatus": {
              "Type": "Task",
              "Resource": "arn:aws:states:::aws-sdk:glue:getCrawler",
              "Parameters": { "Name": "pulsegrid-dev-curated-crawler" },
              "ResultPath": "$.curatedCrawlerStatus",
              "Next": "CheckCuratedCrawlerStatus"
            },
            "CheckCuratedCrawlerStatus": {
              "Type": "Choice",
              "Choices": [
                { "Variable": "$.curatedCrawlerStatus.Crawler.State", "StringEquals": "READY", "Next": "CuratedCrawlDone" }
              ],
              "Default": "WaitForCuratedCrawler"
            },
            "CuratedCrawlDone": { "Type": "Succeed" }
          }
        },
        {
          "StartAt": "StartQuarantineCrawler",
          "States": {
            "StartQuarantineCrawler": {
              "Type": "Task",
              "Resource": "arn:aws:states:::aws-sdk:glue:startCrawler",
              "Parameters": { "Name": "pulsegrid-dev-curated-quarantine-crawler" },
              "ResultPath": null,
              "Next": "WaitForQuarantineCrawler"
            },
            "WaitForQuarantineCrawler": { "Type": "Wait", "Seconds": 20, "Next": "GetQuarantineCrawlerStatus" },
            "GetQuarantineCrawlerStatus": {
              "Type": "Task",
              "Resource": "arn:aws:states:::aws-sdk:glue:getCrawler",
              "Parameters": { "Name": "pulsegrid-dev-curated-quarantine-crawler" },
              "ResultPath": "$.quarantineCrawlerStatus",
              "Next": "CheckQuarantineCrawlerStatus"
            },
            "CheckQuarantineCrawlerStatus": {
              "Type": "Choice",
              "Choices": [
                { "Variable": "$.quarantineCrawlerStatus.Crawler.State", "StringEquals": "READY", "Next": "QuarantineCrawlDone" }
              ],
              "Default": "WaitForQuarantineCrawler"
            },
            "QuarantineCrawlDone": { "Type": "Succeed" }
          }
        }
      ],
      "ResultPath": null,
      "Catch": [
        { "ErrorEquals": ["States.ALL"], "Next": "ReleaseRedshiftLockOnFailure", "ResultPath": "$.error" }
      ],
      "Next": "RunRedshiftRefresh"
    },
    "RunRedshiftRefresh": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:redshiftdata:batchExecuteStatement",
      "Parameters": {
        "WorkgroupName": "pulsegrid-dev-wg",
        "Database": "pulsegrid",
        "SecretArn": "${redshift_secret_arn}",
        "Sqls": [
          "DELETE FROM daily_device_health_summary WHERE dt BETWEEN :start_date AND :end_date",
          "INSERT INTO daily_device_health_summary WITH clean_agg AS (SELECT dt, device_type, facility_id, COUNT(*) AS clean_reading_count, AVG(battery_pct) AS avg_battery_pct, MIN(battery_pct) AS min_battery_pct FROM curated_spectrum.sensor_readings WHERE dt BETWEEN :start_date AND :end_date GROUP BY dt, device_type, facility_id), quarantine_agg AS (SELECT dt, device_type, facility_id, COUNT(*) AS quarantined_reading_count FROM curated_spectrum.quarantine_sensor_readings WHERE dt BETWEEN :start_date AND :end_date GROUP BY dt, device_type, facility_id) SELECT CAST(COALESCE(c.dt, q.dt) AS DATE), COALESCE(c.device_type, q.device_type), COALESCE(c.facility_id, q.facility_id), COALESCE(c.clean_reading_count, 0), COALESCE(q.quarantined_reading_count, 0), COALESCE(c.clean_reading_count, 0) + COALESCE(q.quarantined_reading_count, 0), ROUND(CAST(COALESCE(q.quarantined_reading_count, 0) AS DOUBLE PRECISION) * 100 / NULLIF(COALESCE(c.clean_reading_count, 0) + COALESCE(q.quarantined_reading_count, 0), 0), 2), ROUND(c.avg_battery_pct, 2), c.min_battery_pct FROM clean_agg c FULL OUTER JOIN quarantine_agg q ON c.dt = q.dt AND c.device_type = q.device_type AND c.facility_id = q.facility_id",
          "DELETE FROM daily_motor_vibration_trend WHERE dt BETWEEN :start_date AND :end_date",
          "INSERT INTO daily_motor_vibration_trend SELECT CAST(dt AS DATE), device_id, facility_id, ROUND(AVG(vibration_mm_s), 2), MAX(vibration_mm_s), COUNT(*) FROM curated_spectrum.sensor_readings WHERE device_type = 'motor' AND dt BETWEEN :start_date AND :end_date GROUP BY dt, device_id, facility_id",
          "DELETE FROM daily_cold_storage_risk WHERE dt BETWEEN :start_date AND :end_date",
          "INSERT INTO daily_cold_storage_risk SELECT CAST(dt AS DATE), device_id, facility_id, ROUND(AVG(temperature_c), 2), SUM(door_open_count), COUNT(*) FROM curated_spectrum.sensor_readings WHERE device_type = 'cold_storage_unit' AND dt BETWEEN :start_date AND :end_date GROUP BY dt, device_id, facility_id",
          "DELETE FROM daily_hvac_stability WHERE dt BETWEEN :start_date AND :end_date",
          "INSERT INTO daily_hvac_stability SELECT CAST(dt AS DATE), device_id, facility_id, zone, ROUND(AVG(temperature_c), 2), ROUND(STDDEV(temperature_c), 2), COUNT(*) FROM curated_spectrum.sensor_readings WHERE device_type = 'hvac_unit' AND dt BETWEEN :start_date AND :end_date GROUP BY dt, device_id, facility_id, zone",
          "DELETE FROM daily_energy_voltage_summary WHERE dt BETWEEN :start_date AND :end_date",
          "INSERT INTO daily_energy_voltage_summary SELECT CAST(dt AS DATE), device_id, facility_id, ROUND(SUM(energy_kwh), 2), ROUND(AVG(voltage), 2), MIN(voltage), COUNT(*) FROM curated_spectrum.sensor_readings WHERE device_type = 'smart_meter' AND dt BETWEEN :start_date AND :end_date GROUP BY dt, device_id, facility_id",
          "SELECT MAX(dt) AS max_dt FROM curated_spectrum.sensor_readings WHERE dt BETWEEN :start_date AND :end_date"
        ],
        "Parameters": [
          { "Name": "start_date", "Value.$": "$.redshiftResult.start_date" },
          { "Name": "end_date", "Value.$": "$.redshiftResult.end_date" }
        ]
      },
      "ResultPath": "$.redshiftBatchResult",
      "Catch": [
        { "ErrorEquals": ["States.ALL"], "Next": "ReleaseRedshiftLockOnFailure", "ResultPath": "$.error" }
      ],
      "Next": "WaitForRedshiftStatement"
    },
    "WaitForRedshiftStatement": { "Type": "Wait", "Seconds": 15, "Next": "DescribeRedshiftStatement" },
    "DescribeRedshiftStatement": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:redshiftdata:describeStatement",
      "Parameters": { "Id.$": "$.redshiftBatchResult.Id" },
      "ResultPath": "$.redshiftStatementStatus",
      "Catch": [
        { "ErrorEquals": ["States.ALL"], "Next": "ReleaseRedshiftLockOnFailure", "ResultPath": "$.error" }
      ],
      "Next": "CheckRedshiftStatementStatus"
    },
    "CheckRedshiftStatementStatus": {
      "Type": "Choice",
      "Choices": [
        { "Variable": "$.redshiftStatementStatus.Status", "StringEquals": "FINISHED", "Next": "GetRedshiftMaxDate" },
        { "Variable": "$.redshiftStatementStatus.Status", "StringEquals": "FAILED", "Next": "ReleaseRedshiftLockOnFailure" },
        { "Variable": "$.redshiftStatementStatus.Status", "StringEquals": "ABORTED", "Next": "ReleaseRedshiftLockOnFailure" }
      ],
      "Default": "WaitForRedshiftStatement"
    },
    "GetRedshiftMaxDate": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:redshiftdata:getStatementResult",
      "Parameters": { "Id.$": "$.redshiftStatementStatus.SubStatements[10].Id" },
      "ResultPath": "$.redshiftMaxDateResult",
      "Catch": [
        { "ErrorEquals": ["States.ALL"], "Next": "ReleaseRedshiftLockOnFailure", "ResultPath": "$.error" }
      ],
      "Next": "CheckRedshiftMaxDateFound"
    },
    "CheckRedshiftMaxDateFound": {
      "Type": "Choice",
      "Choices": [
        { "Variable": "$.redshiftMaxDateResult.Records[0][0].StringValue", "IsPresent": true, "Next": "AdvanceRedshiftWatermark" }
      ],
      "Default": "ReleaseRedshiftLockOnSuccess"
    },
    "AdvanceRedshiftWatermark": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "pulsegrid-dev-watermarks",
        "Key": { "pipeline_id": { "S": "redshift_refresh" } },
        "UpdateExpression": "SET last_aggregated_dt = :new_date",
        "ConditionExpression": "attribute_not_exists(last_aggregated_dt) OR last_aggregated_dt < :new_date",
        "ExpressionAttributeValues": {
          ":new_date": { "S.$": "$.redshiftMaxDateResult.Records[0][0].StringValue" }
        }
      },
      "ResultPath": null,
      "Catch": [
        { "ErrorEquals": ["States.ALL"], "Next": "ReleaseRedshiftLockOnSuccess" }
      ],
      "Next": "ReleaseRedshiftLockOnSuccess"
    },
    "ReleaseRedshiftLockOnSuccess": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "pulsegrid-dev-watermarks",
        "Key": { "pipeline_id": { "S": "redshift_refresh" } },
        "UpdateExpression": "SET #s = :idle",
        "ExpressionAttributeNames": { "#s": "status" },
        "ExpressionAttributeValues": { ":idle": { "S": "IDLE" } }
      },
      "ResultPath": null,
      "Retry": [
        { "ErrorEquals": ["States.ALL"], "IntervalSeconds": 5, "MaxAttempts": 3, "BackoffRate": 2.0 }
      ],
      "Next": "ExecutionComplete"
    },
    "ReleaseRedshiftLockOnFailure": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "pulsegrid-dev-watermarks",
        "Key": { "pipeline_id": { "S": "redshift_refresh" } },
        "UpdateExpression": "SET #s = :idle",
        "ExpressionAttributeNames": { "#s": "status" },
        "ExpressionAttributeValues": { ":idle": { "S": "IDLE" } }
      },
      "ResultPath": null,
      "Retry": [
        { "ErrorEquals": ["States.ALL"], "IntervalSeconds": 5, "MaxAttempts": 3, "BackoffRate": 2.0 }
      ],
      "Next": "Fail"
    }
  }
}